#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
AGENT_DIR="${REPO_ROOT}/agent"
RUN_DIR="${AGENT_DIR}/run"
LOG_DIR="${AGENT_DIR}/log"

AGENT_PIDFILE="${RUN_DIR}/agent.pid"
MLX_PIDFILE="${RUN_DIR}/mlx.pid"
TRTLLM_PIDFILE="${RUN_DIR}/trtllm.pid"
COMFYUI_PIDFILE="${RUN_DIR}/comfyui.pid"
WRAPPER_PIDFILE="${RUN_DIR}/wrapper.pid"

AGENT_LOGFILE="${LOG_DIR}/agent.log"
MLX_LOGFILE="${LOG_DIR}/mlx.log"
TRTLLM_LOGFILE="${LOG_DIR}/trtllm.log"
COMFYUI_LOGFILE="${LOG_DIR}/comfyui.log"
WRAPPER_LOGFILE="${LOG_DIR}/wrapper.log"

OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
MLX_HOST="${MLX_HOST:-127.0.0.1}"
MLX_PORT="${MLX_PORT:-8321}"
TRTLLM_HOST="${TRTLLM_HOST:-127.0.0.1}"
TRTLLM_PORT="${TRTLLM_PORT:-8000}"
COMFYUI_HOST="${COMFYUI_HOST:-127.0.0.1}"
COMFYUI_PORT="${COMFYUI_PORT:-8188}"
AGENT_HOST="${AGENT_HOST:-0.0.0.0}"
AGENT_PORT="${AGENT_PORT:-9001}"

mkdir -p "${RUN_DIR}" "${LOG_DIR}"

log(){ echo "[$(date '+%H:%M:%S')] $*" | tee -a "${LOG_DIR}/agent-actions.log" >/dev/null; }
err(){ echo "[ERROR] $*" >&2; }

join_cmd(){
  local out="" arg
  for arg in "$@"; do
    if [[ -n "$out" ]]; then out+=" "; fi
    out+="$(printf '%q' "$arg")"
  done
  echo "$out"
}

run_cmd_logged(){
  local cmd_str
  cmd_str="$(join_cmd "$@")"
  log "[CMD] ${cmd_str}"
  "$@"
}

pid_is_running(){ [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
read_pid(){
  local pidfile="$1" pid
  if [[ ! -f "$pidfile" ]]; then
    echo ""
    return 0
  fi

  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -z "$pid" ]]; then
    rm_pid "$pidfile"
    echo ""
    return 0
  fi

  if ! pid_is_running "$pid"; then
    rm_pid "$pidfile"
    log "[WARN] stale PID file cleaned: ${pidfile}"
    echo ""
    return 0
  fi

  echo "$pid"
}
write_pid(){ echo "$2" > "$1"; }
rm_pid(){ rm -f "$1"; }

probe_url(){ curl -fsS --max-time 2 "$1" >/dev/null 2>&1; }
probe_ollama(){ probe_url "http://${OLLAMA_HOST}:${OLLAMA_PORT}/api/tags"; }
probe_mlx(){ probe_url "http://${MLX_HOST}:${MLX_PORT}/v1/models"; }
probe_trtllm(){ probe_url "http://${TRTLLM_HOST}:${TRTLLM_PORT}/v1/models"; }
probe_comfyui(){ probe_url "http://${COMFYUI_HOST}:${COMFYUI_PORT}/system_stats"; }
probe_agent(){ probe_url "http://127.0.0.1:${AGENT_PORT}/health"; }
probe_wrapper(){ probe_url "http://127.0.0.1:9002/v1/health"; }

start_wrapper(){
  mkdir -p "$(dirname "$WRAPPER_LOGFILE")"
  local py="${AGENT_DIR}/.venv/bin/python"
  [[ -x "$py" ]] || { err "agent venv missing. Run ./scripts/install_agent.sh"; return 4; }
  stop_wrapper || true
  (cd "$REPO_ROOT" && nohup "$py" -m uvicorn agent.backends.wrapper.app:app --host 127.0.0.1 --port 9002 >>"$WRAPPER_LOGFILE" 2>&1 & echo $! >"$WRAPPER_PIDFILE")
  wait_ready probe_wrapper "wrapper" 15
}

stop_wrapper(){ stop_process "$WRAPPER_PIDFILE" "wrapper" || true; rm_pid "$WRAPPER_PIDFILE"; }

wait_ready(){
  local fn="$1" name="$2" tries="${3:-45}"
  for _ in $(seq 1 "$tries"); do
    if "$fn"; then log "$name ready"; return 0; fi
    sleep 1
  done
  err "$name failed health check"
  return 1
}

log_ollama_models(){
  local tags_url="http://${OLLAMA_HOST}:${OLLAMA_PORT}/api/tags"
  local tags
  tags="$(curl -fsS --max-time 5 "$tags_url" 2>/dev/null || true)"
  if [[ -z "$tags" ]]; then
    log "[WARN] unable to fetch ollama tags from ${tags_url}"
    return 0
  fi

  if command -v jq >/dev/null 2>&1; then
    local names count
    names="$(printf '%s' "$tags" | jq -r '.models[]?.name' 2>/dev/null || true)"
    count="$(printf '%s' "$tags" | jq '.models | length' 2>/dev/null || echo 0)"
    log "ollama models available (${count}):"
    if [[ -n "$names" ]]; then
      while IFS= read -r name; do
        [[ -n "$name" ]] && log "  - ${name}"
      done <<< "$names"
    else
      log "  (none)"
    fi
  else
    log "ollama tags response (jq not installed): ${tags}"
  fi
}

stop_process(){
  local pidfile="$1" name="$2" pid
  if [[ ! -f "$pidfile" ]]; then
    log "[WARN] $name PID file not found, attempting fallback stop"
    case "$name" in
      trtllm) pkill -f trtllm 2>/dev/null || true ;;
      mlx) pkill -f mlx 2>/dev/null || true ;;
    esac
    return 0
  fi

  pid="$(read_pid "$pidfile")"
  if [[ -z "$pid" ]]; then
    log "[WARN] $name process not running, skipping stop"
    return 0
  fi

  kill "$pid" 2>/dev/null || true
  sleep 1
  if pid_is_running "$pid"; then kill -9 "$pid" 2>/dev/null || true; fi
  rm_pid "$pidfile"
  log "$name stopped"
}

active_llm(){
  probe_ollama && { echo ollama; return 0; }
  probe_mlx && { echo mlx; return 0; }
  probe_trtllm && { echo trtllm; return 0; }
  return 1
}

stop_other_llm_backends(){
  local keep="$1"
  [[ "$keep" == "mlx" ]] || stop_mlx || log "[WARN] failed to stop mlx"
  [[ "$keep" == "trtllm" ]] || stop_trtllm || log "[WARN] failed to stop trtllm"
}

check_ollama_available(){
  if ! probe_ollama; then
    log "[WARN] Ollama not reachable on port ${OLLAMA_PORT}"
    return 1
  fi
  log "ollama reachable"
  log_ollama_models
}

start_mlx(){
  mkdir -p "$(dirname "$MLX_LOGFILE")"
  log "starting mlx"
  stop_other_llm_backends mlx
  local launcher="${AGENT_DIR}/backends/mlx_run.sh"
  [[ -x "$launcher" ]] || { err "Missing ${launcher}"; return 4; }

  local model_name="${1:-}"
  if [[ -z "$model_name" ]]; then
    echo "ERROR: model argument required for mlx" >&2
    exit 2
  fi

  local model_dir="${AGENT_DIR}/models/mlx/${model_name}"
  if [[ ! -d "$model_dir" ]]; then
    echo "ERROR: MLX model directory not found: $model_dir" >&2
    exit 3
  fi

  # Always stop stale mlx before start to ensure deterministic restart behavior.
  MLX_HOST="$MLX_HOST" MLX_PORT="$MLX_PORT" "$launcher" stop >>"$MLX_LOGFILE" 2>&1 || true

  MLX_HOST="$MLX_HOST" MLX_PORT="$MLX_PORT" "$launcher" start "$model_name" >>"$MLX_LOGFILE" 2>&1

  local pid
  pid="$(read_pid "$MLX_PIDFILE")"
  [[ -n "$pid" ]] || { err "mlx failed to start"; return 3; }
  log "mlx launched with pid $pid"
  wait_ready probe_mlx "mlx" 120
  start_wrapper
}
stop_mlx(){
  stop_wrapper || true
  local launcher="${AGENT_DIR}/backends/mlx_run.sh"
  [[ -x "$launcher" ]] && MLX_HOST="$MLX_HOST" MLX_PORT="$MLX_PORT" "$launcher" stop >>"$MLX_LOGFILE" 2>&1 || log "[WARN] mlx launcher missing; skipping launcher stop"
  stop_process "$MLX_PIDFILE" "mlx" || true
  rm_pid "$MLX_PIDFILE"
  log "mlx stopped"
}

start_trtllm(){
  mkdir -p "$(dirname "$TRTLLM_LOGFILE")"
  log "starting trtllm"
  stop_other_llm_backends trtllm
  local launcher="${AGENT_DIR}/backends/trtllm_run.sh"
  [[ -x "$launcher" ]] || { err "Missing ${launcher}. Run ./scripts/install_trtllm.sh"; return 4; }

  local model_dir="${1:-}"
  if [[ -z "$model_dir" ]]; then
    echo "ERROR: model argument required for trtllm" >&2
    exit 2
  fi

  local trt_model_dir="${AGENT_DIR}/models/trtllm/${model_dir}"
  if [[ ! -d "$trt_model_dir" ]]; then
    echo "ERROR: TRT model directory not found: $trt_model_dir" >&2
    exit 3
  fi

  TRTLLM_PORT="$TRTLLM_PORT" "$launcher" start "$model_dir" >>"$TRTLLM_LOGFILE" 2>&1
  local cpid
  cpid="$(docker inspect -f '{{.State.Pid}}' "bench-race-trtllm" 2>/dev/null || true)"
  [[ -n "$cpid" ]] && write_pid "$TRTLLM_PIDFILE" "$cpid"
  [[ -n "$cpid" ]] || { err "trtllm failed to start"; return 3; }
  log "trtllm launched with pid ${cpid:-unknown}"
  wait_ready probe_trtllm "trtllm" 120
  start_wrapper
}
stop_trtllm(){
  stop_wrapper || true
  local launcher="${AGENT_DIR}/backends/trtllm_run.sh"
  [[ -x "$launcher" ]] && TRTLLM_PORT="$TRTLLM_PORT" "$launcher" stop >>"$TRTLLM_LOGFILE" 2>&1 || log "[WARN] trtllm launcher missing; skipping launcher stop"
  stop_process "$TRTLLM_PIDFILE" "trtllm" || true
  rm_pid "$TRTLLM_PIDFILE"
  log "trtllm stopped"
}

start_comfyui(){
  local dir="${AGENT_DIR}/third_party/comfyui"
  local py="${dir}/.venv/bin/python"
  [[ -x "$py" ]] || { err "comfyui not installed. Run ./scripts/install_agent.sh"; return 4; }
  (cd "$dir" && nohup "$py" main.py --listen "$COMFYUI_HOST" --port "$COMFYUI_PORT" >>"$COMFYUI_LOGFILE" 2>&1 & echo $! >"$COMFYUI_PIDFILE")
  wait_ready probe_comfyui "comfyui" 30
}
stop_comfyui(){ stop_process "$COMFYUI_PIDFILE" "comfyui"; }

start_agent(){
  local py="${AGENT_DIR}/.venv/bin/uvicorn"
  [[ -x "$py" ]] || { err "agent venv missing. Run ./scripts/install_agent.sh"; return 4; }
  nohup "$py" agent.agent_app:app --host "$AGENT_HOST" --port "$AGENT_PORT" >>"$AGENT_LOGFILE" 2>&1 &
  write_pid "$AGENT_PIDFILE" "$!"
  wait_ready probe_agent "agent" 20
}

start_agent_fg(){
  local py="${AGENT_DIR}/.venv/bin/uvicorn"
  [[ -x "$py" ]] || { err "agent venv missing. Run ./scripts/install_agent.sh"; return 4; }
  if probe_agent; then
    err "agent already running on ${AGENT_HOST}:${AGENT_PORT}; stop it before start-fg"
    return 1
  fi
  "$py" agent.agent_app:app --host "$AGENT_HOST" --port "$AGENT_PORT" 2>&1 | tee -a "$AGENT_LOGFILE"
}
stop_agent(){ stop_process "$AGENT_PIDFILE" "agent"; }

show_status_line(){
  local name="$1" pidf="$2" probe="$3"
  local pid="$(read_pid "$pidf")"
  if "$probe"; then echo "- $name: healthy"; return; fi
  if [[ -n "$pid" ]] && pid_is_running "$pid"; then echo "- $name: running (unhealthy)"; else echo "- $name: stopped"; fi
}

status(){
  echo "Backend status"
  if probe_ollama; then echo "- ollama: healthy (external)"; else echo "- ollama: unreachable (external)"; fi
  show_status_line mlx "$MLX_PIDFILE" probe_mlx
  show_status_line trtllm "$TRTLLM_PIDFILE" probe_trtllm
  show_status_line comfyui "$COMFYUI_PIDFILE" probe_comfyui
  show_status_line wrapper "$WRAPPER_PIDFILE" probe_wrapper
  show_status_line agent "$AGENT_PIDFILE" probe_agent
  if active=$(active_llm 2>/dev/null); then echo "Active LLM backend: $active"; else echo "Active LLM backend: none"; fi
}

usage(){
cat <<USAGE
Usage: ./scripts/agent <command>
Commands:
  status
  start
  start-fg
  stop
  start-backend <ollama|mlx|trtllm|comfyui> [model]
  stop-backend <ollama|mlx|trtllm|comfyui>
  start-ollama | stop-ollama
  start-mlx | stop-mlx
  start-trtllm | stop-trtllm
  start-comfyui | stop-comfyui
  start-wrapper | stop-wrapper

Notes:
  - Only one LLM backend can be active at a time: ollama, mlx, trtllm.
  - Ollama is treated as an external service on port ${OLLAMA_PORT}
  - Logs: agent/log/*.log
  - PID files: agent/run/*.pid
  - vLLM was archived; see archive/vllm/README.md
USAGE
}

cmd="${1:-help}"; shift || true
if [[ "$cmd" != "help" && "$cmd" != "-h" && "$cmd" != "--help" && "$cmd" != "" ]]; then
  log "request: ./scripts/agent $(join_cmd "$cmd" "$@")"
fi
case "$cmd" in
  status) status ;;
  start) start_agent ;;
  start-fg) start_agent_fg ;;
  stop) stop_agent; stop_mlx; stop_trtllm; stop_comfyui; stop_wrapper ;;
  start-backend)
    case "${1:-}" in
      ollama)
        stop_other_llm_backends ollama
        check_ollama_available || true
        if [[ -n "${2:-}" ]]; then
          log "central requested ollama model sync/pull for: ${2}"
          run_cmd_logged ollama pull "${2}"
          log "ollama pull finished for model: ${2}"
          log_ollama_models
        fi
        ;;
      mlx) start_mlx "${2:-}" ;;
      trtllm) start_trtllm "${2:-}" ;;
      comfyui) start_comfyui ;;
      *) err "Unknown backend: ${1:-}"; exit 2;;
    esac
    ;;
  stop-backend) case "${1:-}" in ollama) log "ollama is externally managed; nothing to stop" ;; mlx) stop_mlx ;; trtllm) stop_trtllm ;; comfyui) stop_comfyui ;; *) err "Unknown backend: ${1:-}"; exit 2;; esac ;;
  start-ollama) stop_wrapper || true; check_ollama_available || true ;;
  stop-ollama) log "ollama is externally managed; nothing to stop" ;;
  start-mlx) start_mlx "${1:-}" ;;
  stop-mlx) stop_mlx ;;
  start-trtllm) start_trtllm "${1:-}" ;;
  stop-trtllm) stop_trtllm ;;
  start-comfyui) start_comfyui ;;
  stop-comfyui) stop_comfyui ;;
  start-wrapper) start_wrapper ;;
  stop-wrapper) stop_wrapper ;;
  start-vllm|stop-vllm|sync-and-start-vllm)
    err "vLLM lifecycle commands were archived. See archive/vllm/README.md"
    exit 3
    ;;
  help|-h|--help|"") usage ;;
  *) err "Unknown command: $cmd"; usage; exit 2 ;;
esac
